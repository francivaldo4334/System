FROM python:3.13-slim AS base

# 1. Instala as dependências do sistema operacional (incluindo o Cron, gettext e Node.js)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    build-essential \
    libpq-dev \
    git \
    cron \
    gettext \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# 2. Instala o 'uv' diretamente do binário oficial
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# 3. Variáveis de ambiente estáveis para o Python
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=core.settings.prod

# 4. Copia os arquivos de travamento (Cache de Camada)
COPY pyproject.toml uv.lock ./

# Exporta o uv.lock para requirements padrão e instala direto no sistema
RUN uv pip compile pyproject.toml -o requirements.txt && \
    uv pip install --system -r requirements.txt

# 5. Copia o código-fonte
COPY . .

# 6. Build de arquivos estáticos (Tailwind), collectstatic e traduções
# Nota: tailwind install baixa as dependências do Node para o tema
RUN python manage.py tailwind install && \
    python manage.py tailwind build && \
    python manage.py collectstatic && \
    python manage.py compilemessages

# 7. Garante a permissão de execução
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
