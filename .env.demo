# Banco de Dados (O Host PRECISA ser 'db', que é o nome do serviço no compose)
DB_NAME=seu_banco_prod
DB_USER=seu_usuario_prod
DB_PASSWORD=sua_senha_segura_aqui
DB_HOST=db

# Segurança e Roteamento Local
# O .localhost permite que você teste subdomínios no navegador (ex: tenant1.localhost)
ALLOWED_HOSTS=.localhost,127.0.0.1,web,localhost
ROOT_URLCONF=core.urls
# Configurações de Eamil (SES)

AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_SES_REGION_NAME=AWS_SES_REGION_NAME
AWS_SES_REGION_NAME=AWS_SES_REGION_NAME
# Configurações de Email (Mantidas para quando precisar ligar)
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=postmaster@seudominio.com
# EMAIL_HOST_PASSWORD=sua_senha_smtp

REDIS_PASSWORD=senha_redis
